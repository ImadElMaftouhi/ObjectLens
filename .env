# ObjectLens Local Development Configuration
# This file overrides default settings for local development (outside Docker)

# MongoDB - use localhost instead of Docker hostname
MONGO_URI=mongodb://localhost:27017/objectlens

# CORS - allow frontend dev server
CORS_ORIGINS=http://localhost:5173

# For local development
DATASET_ROOT=data/imagenet_4_yolo/images
RAW_DATA_ROOT=data/3D_data/raw

# For Docker
DATASET_ROOT=/data/imagenet_4_yolo/images
RAW_DATA_ROOT=/data/3D_data/raw